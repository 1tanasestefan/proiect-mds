# VibeTrips - Python Backend Environment
# Copy this file to .env and fill only the values you use.
# Never commit .env to version control.

# Local AI inference through Ollama.
# Install Ollama, then run: ollama pull llama3.1:8b
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Supabase is still required for login, saved trips, likes, forks, and dashboard data.
# SUPABASE_KEY must be the service_role key and must stay backend-only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhb...service_role_key_here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Server
PORT=8000
